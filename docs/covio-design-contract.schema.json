{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covio.local/schemas/covio-design-contract.schema.json",
  "title": "Covio Design Contract",
  "description": "Machine-readable design contract for Covio product design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "tokens",
    "components",
    "states",
    "copy",
    "platformMapping",
    "figmaNodeMap",
    "variables"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^token/"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/token"
          },
          {
            "$ref": "#/$defs/motionToken"
          }
        ]
      }
    },
    "components": {
      "type": "object",
      "minProperties": 30,
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^component/"
      },
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    },
    "states": {
      "$ref": "#/$defs/states"
    },
    "copy": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^copy/"
      },
      "additionalProperties": {
        "$ref": "#/$defs/copyEntry"
      }
    },
    "platformMapping": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^platform/"
      },
      "additionalProperties": {
        "$ref": "#/$defs/platformMapping"
      }
    },
    "figmaNodeMap": {
      "$ref": "#/$defs/figmaNodeMap"
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFile",
        "collections",
        "total",
        "policy"
      ],
      "properties": {
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "collections": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "modes",
              "authority"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "authority": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "updatedAt",
        "authority",
        "visualProjection",
        "reference",
        "counts",
        "fonts",
        "kotlinInterfaces",
        "validation",
        "knownDifferences",
        "sourceKit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "visualProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName",
            "fileKey",
            "url"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "fileKey": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName",
            "fileKey",
            "url"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "fileKey": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pages",
            "sections",
            "boards",
            "componentSets",
            "componentNodes",
            "variables",
            "textStyles",
            "textNodes",
            "sourcePages",
            "deliveryPages",
            "sourceComponentSets",
            "customSystemControls"
          ],
          "properties": {
            "pages": {
              "type": "integer",
              "minimum": 0
            },
            "sections": {
              "type": "integer",
              "minimum": 0
            },
            "componentSets": {
              "type": "integer",
              "minimum": 0
            },
            "componentNodes": {
              "type": "integer",
              "minimum": 0
            },
            "variables": {
              "type": "integer",
              "minimum": 0
            },
            "textStyles": {
              "type": "integer",
              "minimum": 0
            },
            "textNodes": {
              "type": "integer",
              "minimum": 0
            },
            "sourcePages": {
              "type": "integer",
              "minimum": 0
            },
            "deliveryPages": {
              "type": "integer",
              "minimum": 0
            },
            "sourceComponentSets": {
              "type": "integer",
              "minimum": 0
            },
            "boards": {
              "type": "integer",
              "minimum": 0
            },
            "customSystemControls": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "status",
              "usage"
            ],
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "kotlinInterfaces": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "purpose",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "future-not-implemented",
                  "implemented"
                ],
                "description": "implemented 的条目要带 path，指向实现所在的文件。"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "实现所在的文件，相对仓库根目录。只有 implemented 的条目有。"
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaValidation",
            "figmaCrossCheck",
            "staticVisualAudit",
            "nativeSourceAudit"
          ],
          "properties": {
            "schemaValidation": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "figmaCrossCheck": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "staticVisualAudit": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "nativeSourceAudit": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            }
          }
        },
        "knownDifferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area",
              "difference",
              "status"
            ],
            "properties": {
              "area": {
                "type": "string",
                "minLength": 1
              },
              "difference": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceKit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName",
            "fileKey",
            "url",
            "counts"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "fileKey": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pages",
                "componentSets",
                "variables",
                "textStyles"
              ],
              "properties": {
                "pages": {
                  "type": "integer",
                  "minimum": 0
                },
                "componentSets": {
                  "type": "integer",
                  "minimum": 0
                },
                "variables": {
                  "type": "integer",
                  "minimum": 0
                },
                "textStyles": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "light",
        "dark",
        "purpose",
        "lightVariableId",
        "darkVariableId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "color",
            "dimension"
          ]
        },
        "light": {
          "type": [
            "string",
            "number"
          ]
        },
        "dark": {
          "type": [
            "string",
            "number"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "lightVariableId": {
          "type": "string",
          "minLength": 1
        },
        "darkVariableId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "figmaComponentSetId",
        "purpose",
        "variants",
        "properties",
        "states",
        "accessibilityRules",
        "composeMapping",
        "figmaComponentSetIds",
        "sourceAuthority"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "figmaComponentSetId": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "defaultValue"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "VARIANT",
                  "TEXT",
                  "BOOLEAN",
                  "INSTANCE_SWAP",
                  "SLOT"
                ]
              },
              "defaultValue": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibilityRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composeMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "behavior"
          ],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "behavior": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "nativeSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "modeVariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figmaComponentSetIds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceAuthority": {
          "type": "string",
          "minLength": 1
        },
        "swiftMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "behavior"
          ],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "behavior": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "macOS 的 Swift 落点。schema 无法表达「macOS 下必填」，这条要求由 scripts/validate-contract.py 检查。"
        }
      }
    },
    "copyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh-Hans"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platformMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentKey",
        "runtimeTarget",
        "behavior",
        "status"
      ],
      "properties": {
        "componentKey": {
          "type": "string",
          "minLength": 1
        },
        "runtimeTarget": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "native-source-mapped",
            "swift-source-mapped",
            "dual-source-mapped"
          ],
          "description": "native-source-mapped：只有原生源码落点。swift-source-mapped：只有 Swift 落点。dual-source-mapped：Compose 与 Swift 两边都有落点。"
        },
        "swiftRuntimeTarget": {
          "type": "string",
          "minLength": 1,
          "description": "macOS 下的 Swift 类型。与 component 的 swiftMapping.target 一致。"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellKey",
        "pageKey",
        "pageTitle",
        "boardId",
        "state",
        "description",
        "copyKey"
      ],
      "properties": {
        "cellKey": {
          "type": "string",
          "minLength": 1
        },
        "pageKey": {
          "type": "string",
          "minLength": 1
        },
        "pageTitle": {
          "type": "string",
          "minLength": 1
        },
        "boardId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "NORMAL",
            "EMPTY",
            "LOADING",
            "SUCCESS",
            "WARNING",
            "ERROR",
            "DISABLED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "copyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topShelfState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "slug",
        "description",
        "copyKey"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "copyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adoptionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "referencePage",
        "referenceNodeId",
        "covioTarget",
        "adoptionResult",
        "contractKey",
        "rationale",
        "evidence",
        "verificationStatus"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "referencePage": {
          "type": "string",
          "minLength": 1
        },
        "referenceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "covioTarget": {
          "type": "string",
          "minLength": 1
        },
        "adoptionResult": {
          "enum": [
            "adopt",
            "adapt",
            "reject"
          ]
        },
        "contractKey": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "enum": [
            "verified-static"
          ]
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "materialDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "decision",
        "contractKey",
        "figmaDecision",
        "composeDecision",
        "parameters",
        "evidence"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "contractKey": {
          "type": "string",
          "minLength": 1
        },
        "figmaDecision": {
          "enum": [
            "adopt",
            "adapt",
            "reject"
          ]
        },
        "composeDecision": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageStateMatrix",
        "topShelfInteractionStates",
        "macos27Alignment",
        "notchOutputHub",
        "menuBarAndNotchHub"
      ],
      "properties": {
        "pageStateMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boardId",
            "columns",
            "rows",
            "cells"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "enum": [
                  "NORMAL",
                  "EMPTY",
                  "LOADING",
                  "SUCCESS",
                  "WARNING",
                  "ERROR",
                  "DISABLED"
                ]
              }
            },
            "rows": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cells": {
              "type": "array",
              "minItems": 42,
              "maxItems": 42,
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "topShelfInteractionStates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boardId",
            "states"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "minLength": 1
            },
            "states": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/topShelfState"
              }
            }
          }
        },
        "notchOutputHub": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boardId",
            "layouts",
            "states",
            "interactionPath",
            "contractKey"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "minLength": 1
            },
            "layouts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/notchHubLayout"
              }
            },
            "states": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/notchHubState"
              }
            },
            "interactionPath": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contractKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "menuBarAndNotchHub": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boardIds",
            "componentSetIds",
            "menuBarLayouts",
            "statusItemStates",
            "hubStates",
            "interactionPath",
            "contractKey"
          ],
          "properties": {
            "boardIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "componentSetIds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statusItem"
              ],
              "properties": {
                "statusItem": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "menuBarLayouts": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "mode",
                  "display",
                  "contractKey"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "Light",
                      "Dark"
                    ]
                  },
                  "display": {
                    "enum": [
                      "Notched",
                      "Notchless"
                    ]
                  },
                  "contractKey": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "statusItemStates": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
