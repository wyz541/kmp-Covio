---
import { getCollection } from 'astro:content';
import IndexCard from './IndexCard.astro';
import pending from '../../content/docs/components/pending.json';
import extensions from '../../content/docs/components/extensions.json';

const entries = (await getCollection('docs', ({ data }) => Boolean(data.component))).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'zh-CN')
);

const kindLabels: Record<string, string> = {
  shell: '外壳',
  surface: '界面区域',
  navigation: '导航',
  control: '控件',
  container: '容器',
  feedback: '反馈',
  indicator: '指示器',
  menu: '菜单',
  content: '内容',
  decoration: '装饰',
};

const statusLabels: Record<string, string> = {
  draft: '草稿',
  preview: '预览',
  stable: '稳定',
  deprecated: '已弃用',
};

const pendingCount = pending.components.length;
const extensionIds = new Set(extensions.components.map((component) => component.id));
const authoredContractCount = entries.filter(
  (entry) => !extensionIds.has(entry.data.component?.id ?? '')
).length;
const contractTotal = authoredContractCount + pendingCount;
---

<div class="guide-catalog-summary">
  <div>
    <strong>{authoredContractCount} / {contractTotal}</strong>
    <span>合同组件已写</span>
  </div>
  <div>
    <strong>{pendingCount}</strong>
    <span>合同组件待补</span>
  </div>
  <div>
    <strong>{extensionIds.size}</strong>
    <span>扩展组件</span>
  </div>
</div>

<div class="guide-index-grid">
  {entries.map((entry, index) => (
    <IndexCard
      index={String(index + 1).padStart(2, '0')}
      title={entry.data.title}
      description={entry.data.component?.definition ?? entry.data.description ?? ''}
      href={`/${entry.id}/`}
      meta={[
        kindLabels[entry.data.component?.kind ?? ''] ?? entry.data.component?.kind,
        statusLabels[entry.data.component?.status ?? ''] ?? entry.data.component?.status,
      ]
        .filter(Boolean)
        .join(' · ')}
    />
  ))}
</div>

{
  pendingCount > 0 && (
    <div class="guide-index-note">
      <strong>覆盖进度</strong>
      <p>
        设计合同还有 {pendingCount} 个组件待补。清单在
        <code>pending.json</code>，每完成一个组件就移出清单。
      </p>
    </div>
  )
}
