---
const { entry } = Astro.locals.starlightRoute;
---

{entry.data.template !== 'splash' && <h1 id="_top">{entry.data.title}</h1>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
