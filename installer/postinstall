#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
unset COVIO_TX_TEST_MODE COVIO_TX_STATE_ROOT COVIO_TX_APPLICATIONS_ROOT \
  COVIO_TX_ATOMIC_SWAP COVIO_TX_HELPER_PATH COVIO_TX_LAUNCHD_PATH \
  COVIO_TX_CODESIGN COVIO_TX_DITTO COVIO_TX_FIND \
  COVIO_TX_INSTALL COVIO_TX_LAUNCHCTL COVIO_TX_LIPO COVIO_TX_PGREP COVIO_TX_PLUTIL \
  COVIO_TX_SHASUM COVIO_TX_SPCTL COVIO_TX_STAPLER COVIO_TX_UNAME COVIO_TX_ID \
  COVIO_TX_WAIT_ATTEMPTS
umask 077
# shellcheck source=transaction.sh
source "$SCRIPT_DIR/transaction.sh"

TX_ENVIRONMENT_SOURCE="$SCRIPT_DIR/transaction.env"
covio_tx_load_environment "$TX_ENVIRONMENT_SOURCE"
covio_tx_configure "/Library/Application Support/Covio" "/Applications"
covio_tx_commit
